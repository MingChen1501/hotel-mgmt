{
  "operation": "GetGuest",
  "contract": "GuestService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 5", "docs/technical/integration.md section 2", "FR-GST-1", "FR-CUS-1"],
  "transport": {
    "method": "POST",
    "path": "/v1/guests/GetGuest",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["guestId"],
    "properties": {
      "guestId": { "type": "string", "format": "uuid" }
    }
  },
  "response": {
    "type": "object",
    "required": ["guestId", "fullName", "returningFlag", "pastStayCount", "stayLinks", "mandatoryFieldStatus"],
    "properties": {
      "guestId": { "type": "string", "format": "uuid" },
      "fullName": { "type": "string" },
      "contact": { "type": "object", "additionalProperties": true },
      "preferences": { "type": "object", "additionalProperties": true },
      "notes": { "type": "string" },
      "returningFlag": { "type": "boolean" },
      "pastStayCount": { "type": "integer" },
      "stayLinks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
      "mandatoryFieldStatus": {
        "type": "object",
        "required": ["complete", "missingFields"],
        "properties": {
          "complete": { "type": "boolean" },
          "missingFields": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "NOT_FOUND", "status": 404, "when": "Unknown guest." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing guestId." }
  ]
}

{
  "operation": "ChangeSecret",
  "contract": "AdminService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 8", "docs/technical/integration.md section 6 C10", "FR-ADM-2", "NFR-SEC-2"],
  "transport": {
    "method": "POST",
    "path": "/v1/admin/ChangeSecret",
    "auth": "Bearer session token (any role; caller rotates their own secret only)"
  },
  "request": {
    "type": "object",
    "required": ["currentSecret", "newSecret"],
    "properties": {
      "currentSecret": { "type": "string", "description": "Proof of possession; never stored, compared as a hash." },
      "newSecret": { "type": "string", "description": "Stored as a hash only, never plaintext." }
    }
  },
  "response": {
    "type": "object",
    "required": ["userId", "displayName", "signinIdentity", "role"],
    "properties": {
      "userId": { "type": "string", "format": "uuid" },
      "displayName": { "type": "string" },
      "signinIdentity": { "type": "string" },
      "role": { "type": "string", "enum": ["owner", "manager", "front-desk"] }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing, expired, or revoked session token; or wrong currentSecret (no lockout-counter side effects)." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing currentSecret or newSecret." }
  ]
}

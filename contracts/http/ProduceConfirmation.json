{
  "operation": "ProduceConfirmation",
  "contract": "GuestService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 5", "FR-GST-4"],
  "transport": {
    "method": "POST",
    "path": "/v1/guests/ProduceConfirmation",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["reservationRef"],
    "properties": {
      "reservationRef": { "type": "string", "format": "uuid" }
    }
  },
  "response": {
    "type": "object",
    "required": ["reservationRef", "hotel", "guest", "dates", "type", "price"],
    "properties": {
      "reservationRef": { "type": "string", "format": "uuid" },
      "hotel": {
        "type": "object",
        "required": ["hotelId", "name"],
        "properties": {
          "hotelId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      },
      "guest": {
        "type": "object",
        "required": ["guestId", "fullName"],
        "properties": {
          "guestId": { "type": "string", "format": "uuid" },
          "fullName": { "type": "string" }
        }
      },
      "dates": {
        "type": "object",
        "required": ["checkIn", "checkOut"],
        "properties": {
          "checkIn": { "type": "string", "format": "date" },
          "checkOut": { "type": "string", "format": "date" }
        }
      },
      "type": { "type": "string" },
      "price": {
        "type": "object",
        "required": ["amountMinor", "currency"],
        "properties": {
          "amountMinor": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string" }
        }
      }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "NOT_FOUND", "status": 404, "when": "Unknown reservationRef." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing or malformed reservationRef." }
  ]
}

{
  "operation": "QueryCalendar",
  "contract": "ReservationService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 1", "FR-RES-5"],
  "transport": {
    "method": "POST",
    "path": "/v1/reservations/QueryCalendar",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["dateFrom", "dateTo"],
    "properties": {
      "dateFrom": { "type": "string", "format": "date" },
      "dateTo": { "type": "string", "format": "date" },
      "roomTypeId": { "type": "string", "format": "uuid" }
    }
  },
  "response": {
    "type": "object",
    "required": ["dateFrom", "dateTo", "reservations"],
    "properties": {
      "dateFrom": { "type": "string", "format": "date" },
      "dateTo": { "type": "string", "format": "date" },
      "reservations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["reservationRef", "roomTypeId", "arrivalDate", "departureDate", "state"],
          "properties": {
            "reservationRef": { "type": "string" },
            "roomTypeId": { "type": "string", "format": "uuid" },
            "arrivalDate": { "type": "string", "format": "date" },
            "departureDate": { "type": "string", "format": "date" },
            "state": { "type": "string" }
          }
        }
      }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing field or bad date order." }
  ]
}

{
  "operation": "UpsertRatePlan",
  "contract": "PricingService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 4", "FR-RTE-1"],
  "transport": {
    "method": "POST",
    "path": "/v1/rates/UpsertRatePlan",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string" },
      "description": { "type": "string" },
      "defaultUnits": { "type": "integer", "minimum": 0, "description": "Cached inventory input: sellable units per room type when the caller supplies none." }
    }
  },
  "response": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string" },
      "description": { "type": ["string", "null"] }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing name." }
  ]
}

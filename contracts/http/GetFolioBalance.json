{
  "operation": "GetFolioBalance",
  "contract": "BillingService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 6", "docs/technical/integration.md section 3", "FR-BIL-1"],
  "transport": {
    "method": "POST",
    "path": "/v1/billing/GetFolioBalance",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["stayId", "actor"],
    "properties": {
      "stayId": { "type": "string", "format": "uuid" },
      "actor": { "type": "string" }
    }
  },
  "response": {
    "type": "object",
    "required": ["folioId", "stayId", "balanceMinor", "charges", "payments"],
    "properties": {
      "folioId": { "type": "string", "format": "uuid" },
      "stayId": { "type": "string", "format": "uuid" },
      "balanceMinor": { "type": "integer" },
      "openBalanceApproval": { "type": ["object", "null"] },
      "charges": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
      "payments": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing or malformed stayId." }
  ]
}

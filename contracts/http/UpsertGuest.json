{
  "operation": "UpsertGuest",
  "contract": "GuestService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 5", "docs/technical/integration.md section 1", "FR-GST-1", "FR-GST-2"],
  "transport": {
    "method": "POST",
    "path": "/v1/guests/UpsertGuest",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["fullName", "actor"],
    "properties": {
      "guestId": { "type": "string", "format": "uuid", "description": "Guest id; generated when absent." },
      "fullName": { "type": "string" },
      "contact": { "type": "object", "additionalProperties": true },
      "preferences": { "type": "object", "additionalProperties": true },
      "notes": { "type": "string" },
      "actor": { "type": "string" }
    }
  },
  "response": {
    "type": "object",
    "required": ["guestId", "fullName"],
    "properties": {
      "guestId": { "type": "string", "format": "uuid" },
      "fullName": { "type": "string" },
      "contact": { "type": "object", "additionalProperties": true },
      "preferences": { "type": "object", "additionalProperties": true },
      "notes": { "type": "string" },
      "returningFlag": { "type": "boolean" },
      "pastStayCount": { "type": "integer" }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing fullName or actor." }
  ]
}

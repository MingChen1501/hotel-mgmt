{
  "operation": "CreateReservation",
  "contract": "ReservationService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 1", "docs/technical/integration.md section 1", "FR-RES-1", "FR-RTE-5", "NFR-CON-1"],
  "transport": {
    "method": "POST",
    "path": "/v1/reservations/CreateReservation",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["roomTypeId", "arrivalDate", "departureDate", "guest", "sellableUnits", "priceBasis"],
    "properties": {
      "roomTypeId": { "type": "string", "format": "uuid" },
      "arrivalDate": { "type": "string", "format": "date" },
      "departureDate": { "type": "string", "format": "date" },
      "guest": {
        "type": "object",
        "required": ["guestId"],
        "properties": {
          "guestId": { "type": "string", "format": "uuid", "description": "Logical reference to the guests schema." },
          "fullName": { "type": "string" },
          "contact": { "type": "string" }
        }
      },
      "sellableUnits": { "type": "integer", "minimum": 1, "description": "Desk-loop input from the Rates/Rooms search step; the atomic guard refuses when overlapping bookings reach it." },
      "priceBasis": {
        "type": "object",
        "required": ["totalMinor"],
        "properties": {
          "totalMinor": { "type": "integer", "minimum": 0 },
          "discountName": { "type": ["string", "null"] }
        }
      },
      "discountName": { "type": "string" },
      "idempotencyKey": { "type": "string" }
    }
  },
  "response": {
    "type": "object",
    "required": ["reservationRef", "state", "quotedTotal"],
    "properties": {
      "reservationRef": { "type": "string" },
      "state": { "type": "string", "const": "confirmed" },
      "quotedTotal": { "type": "integer" }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "CONFLICT", "status": 409, "when": "No sellable unit left for the type and dates; details name type+dates (NFR-CON-1)." },
    { "code": "STATE_ILLEGAL", "status": 422, "when": "A stay restriction is violated; details name the restriction (FR-RTE-4)." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing field, bad date order, or a hotel-mandatory guest field is missing (FR-CUS-1)." }
  ]
}

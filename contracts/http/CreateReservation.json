{
  "operation": "CreateReservation",
  "contract": "ReservationService",
  "version": "1.2",
  "traces": [
    "docs/architecture/lld.md section 1",
    "docs/technical/integration.md section 1",
    "FR-RES-1",
    "FR-RTE-5",
    "NFR-CON-1",
    "FR-OVB-1",
    "FR-OVB-3",
    "ADR-0006"
  ],
  "transport": {
    "method": "POST",
    "path": "/v1/reservations/CreateReservation",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": [
      "roomTypeId",
      "arrivalDate",
      "departureDate",
      "guest",
      "priceBasis"
    ],
    "properties": {
      "roomTypeId": {
        "type": "string",
        "format": "uuid"
      },
      "arrivalDate": {
        "type": "string",
        "format": "date"
      },
      "departureDate": {
        "type": "string",
        "format": "date"
      },
      "guest": {
        "type": "object",
        "required": [
          "guestId"
        ],
        "properties": {
          "guestId": {
            "type": "string",
            "format": "uuid",
            "description": "Logical reference to the guests schema."
          },
          "fullName": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          }
        }
      },
      "sellableUnits": {
        "type": "integer",
        "minimum": 0,
        "description": "Optional and advisory (ADR-0006): ignored for the booking decision; the server derives the ceiling from the room inventory Rooms records. A malformed value is still VALIDATION_FAILED."
      },
      "priceBasis": {
        "type": "object",
        "required": [
          "totalMinor"
        ],
        "properties": {
          "totalMinor": {
            "type": "integer",
            "minimum": 0
          },
          "discountName": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "discountName": {
        "type": "string"
      },
      "idempotencyKey": {
        "type": "string"
      }
    }
  },
  "response": {
    "type": "object",
    "required": [
      "reservationRef",
      "state",
      "quotedTotal",
      "reservationId",
      "stayId"
    ],
    "properties": {
      "reservationRef": {
        "type": "string"
      },
      "state": {
        "type": "string",
        "const": "confirmed"
      },
      "quotedTotal": {
        "type": "integer"
      },
      "reservationId": {
        "type": "string",
        "format": "uuid"
      },
      "stayId": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "errors": [
    {
      "code": "UNAUTHENTICATED",
      "status": 401,
      "when": "Missing session token."
    },
    {
      "code": "CONFLICT",
      "status": 409,
      "when": "No sellable unit left for the type and dates; details name type+dates (NFR-CON-1)."
    },
    {
      "code": "UPSTREAM_UNAVAILABLE",
      "status": 503,
      "when": "The room inventory could not be read, so the booking was refused; details name upstream rooms and CheckRoomTypeSellability (ADR-0006 D4)."
    },
    {
      "code": "STATE_ILLEGAL",
      "status": 422,
      "when": "A stay restriction is violated; details name the restriction (FR-RTE-4)."
    },
    {
      "code": "VALIDATION_FAILED",
      "status": 400,
      "when": "Missing field, bad date order, or a hotel-mandatory guest field is missing (FR-CUS-1)."
    },
    {
      "code": "NOT_FOUND",
      "status": 404,
      "when": "Unknown room type: Rooms refused the capacity read and the refusal is surfaced unchanged (ADR-0006 D4)."
    }
  ]
}

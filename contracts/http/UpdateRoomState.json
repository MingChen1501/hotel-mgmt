{
  "operation": "UpdateRoomState",
  "contract": "RoomInventoryService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 3", "FR-RMS-2", "BR-28", "NFR-AUD-1"],
  "transport": {
    "method": "POST",
    "path": "/v1/rooms/UpdateRoomState",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["roomNumber", "newState", "actor"],
    "properties": {
      "roomNumber": { "type": "string" },
      "newState": { "type": "string", "enum": ["occupied", "vacant-dirty", "vacant-clean", "vacant-inspected", "out-of-order"] },
      "actor": { "type": "string" }
    }
  },
  "response": {
    "type": "object",
    "required": ["roomNumber", "oldState", "newState"],
    "properties": {
      "roomNumber": { "type": "string" },
      "oldState": { "type": "string" },
      "newState": { "type": "string" }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "NOT_FOUND", "status": 404, "when": "Unknown room number." },
    { "code": "STATE_ILLEGAL", "status": 422, "when": "Illegal transition, e.g. dirty straight to inspected (BR-28)." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing field or unknown state value." }
  ]
}

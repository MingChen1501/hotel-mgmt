{
  "operation": "ReleaseRoom",
  "contract": "RoomInventoryService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 3", "docs/technical/integration.md section 2 C5", "FR-FDK-2"],
  "transport": {
    "method": "POST",
    "path": "/v1/rooms/ReleaseRoom",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["roomNumber", "actor"],
    "properties": {
      "roomNumber": { "type": "string" },
      "toState": { "type": "string", "enum": ["vacant-dirty", "vacant-clean", "vacant-inspected", "out-of-order"], "default": "vacant-dirty" },
      "actor": { "type": "string" }
    }
  },
  "response": {
    "type": "object",
    "required": ["roomNumber", "oldState", "newState"],
    "properties": {
      "roomNumber": { "type": "string" },
      "oldState": { "type": "string" },
      "newState": { "type": "string" }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "NOT_FOUND", "status": 404, "when": "Unknown room number." },
    { "code": "STATE_ILLEGAL", "status": 422, "when": "Room is not occupied." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing field or unknown toState value." }
  ]
}

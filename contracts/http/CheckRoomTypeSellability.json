{
  "operation": "CheckRoomTypeSellability",
  "contract": "RoomInventoryService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md sections 1 and 3", "docs/technical/integration.md section 1 C2", "FR-RMS-3", "BR-12"],
  "transport": {
    "method": "POST",
    "path": "/v1/rooms/CheckRoomTypeSellability",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["roomType", "dateFrom", "dateTo"],
    "properties": {
      "roomType": { "type": "string", "description": "Room-type name or id." },
      "dateFrom": { "type": "string", "format": "date" },
      "dateTo": { "type": "string", "format": "date" },
      "roomNumber": { "type": "string", "description": "Optional: check one room; a covering block refuses naming the block." }
    }
  },
  "response": {
    "type": "object",
    "required": ["roomTypeId", "dateFrom", "dateTo", "totalCount", "sellableCount", "blockedRooms"],
    "properties": {
      "roomTypeId": { "type": "string", "format": "uuid" },
      "dateFrom": { "type": "string", "format": "date" },
      "dateTo": { "type": "string", "format": "date" },
      "totalCount": { "type": "integer" },
      "sellableCount": { "type": "integer", "description": "Rooms of the type with no overlapping out-of-order block." },
      "blockedRooms": { "type": "array", "items": { "type": "string" } }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "NOT_FOUND", "status": 404, "when": "Unknown room type or room number." },
    { "code": "STATE_ILLEGAL", "status": 422, "when": "Named roomNumber is covered by a block; details name the block (FR-RMS-3, BR-12)." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing field or dateTo before dateFrom." }
  ]
}

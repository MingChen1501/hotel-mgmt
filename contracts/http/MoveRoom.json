{
  "operation": "MoveRoom",
  "contract": "StayService",
  "version": "1.0",
  "traces": ["docs/architecture/lld.md section 2", "docs/technical/integration.md section 2 C5", "FR-FDK-3", "NFR-CON-2"],
  "transport": {
    "method": "POST",
    "path": "/v1/stay/MoveRoom",
    "auth": "Bearer session token"
  },
  "request": {
    "type": "object",
    "required": ["stayId", "toRoomId", "actor"],
    "properties": {
      "stayId": { "type": "string", "format": "uuid" },
      "toRoomId": { "type": "string", "format": "uuid", "description": "New room, assigned through RoomInventoryService AssignRoom first." },
      "idempotencyKey": { "type": "string" },
      "actor": { "type": "string" }
    }
  },
  "response": {
    "type": "object",
    "required": ["stayId", "reservationId", "guestId", "roomId", "state", "move"],
    "properties": {
      "stayId": { "type": "string", "format": "uuid" },
      "reservationId": { "type": "string", "format": "uuid" },
      "guestId": { "type": "string", "format": "uuid" },
      "roomId": { "type": "string", "format": "uuid" },
      "state": { "type": "string", "const": "in-house" },
      "move": {
        "type": "object",
        "required": ["fromRoomId", "toRoomId", "movedAt"],
        "properties": {
          "fromRoomId": { "type": "string", "format": "uuid" },
          "toRoomId": { "type": "string", "format": "uuid" },
          "movedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "errors": [
    { "code": "UNAUTHENTICATED", "status": 401, "when": "Missing session token." },
    { "code": "CONFLICT", "status": 409, "when": "Target room just taken; details name the room (raised via AssignRoom)." },
    { "code": "STATE_ILLEGAL", "status": 422, "when": "Stay is not in house; details name the stay and its state." },
    { "code": "NOT_FOUND", "status": 404, "when": "Unknown stay." },
    { "code": "VALIDATION_FAILED", "status": 400, "when": "Missing link, or the guest is already in that room." }
  ]
}
